{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/plugins/v1/online.schema.json",
  "title": "MusicFS 在线 Provider 匿名只读控制面 1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Success"
    },
    {
      "$ref": "#/$defs/Failure"
    },
    {
      "$ref": "#/$defs/Cancel"
    }
  ],
  "$defs": {
    "Context": {"type":"object","additionalProperties":false,"required":["instanceId","userId","taskId","timeoutMs"],"properties":{"instanceId":{"type":"string","minLength":1,"maxLength":128},"userId":{"type":"string","minLength":1,"maxLength":128},"taskId":{"type":"string","pattern":"^[0-9a-f]{48}$"},"timeoutMs":{"type":"integer","minimum":1,"maximum":30000},"accountRef":{"const":""}}},
    "Hello": {"type":"object","additionalProperties":false,"required":["protocolVersion","instanceId","nonce","configRevision","userId","timeoutMs"],"properties":{"protocolVersion":{"const":"1.0"},"instanceId":{"type":"string","minLength":1,"maxLength":128},"nonce":{"type":"string","pattern":"^[0-9a-f]{48}$"},"configRevision":{"const":"online-anonymous-v1"},"userId":{"type":"string","minLength":1,"maxLength":128},"timeoutMs":{"type":"integer","minimum":1000,"maximum":30000}}},
    "Scope": {"type":"object","additionalProperties":false,"required":["context"],"properties":{"context":{"$ref":"#/$defs/Context"}}},
    "Search": {"type":"object","additionalProperties":false,"required":["context","query","limit","cursor"],"properties":{"context":{"$ref":"#/$defs/Context"},"query":{"type":"string","minLength":1,"maxLength":256},"limit":{"type":"integer","minimum":1,"maximum":50},"cursor":{"type":"string","minLength":0,"maxLength":1024}}},
    "Reference": {"type":"object","additionalProperties":false,"required":["context","externalId"],"properties":{"context":{"$ref":"#/$defs/Context"},"externalId":{"type":"string","pattern":"^[A-Za-z0-9]{1,64}$"}}},
    "Recommendations": {"type":"object","additionalProperties":false,"required":["context","limit"],"properties":{"context":{"$ref":"#/$defs/Context"},"limit":{"type":"integer","minimum":1,"maximum":50}}},
    "Capability": {"type":"object","additionalProperties":false,"required":["name","supported","reason"],"properties":{"name":{"enum":["search.tracks","metadata.track","playlist.observe","recommendations.playlists","account.login","stream.resolve"]},"supported":{"type":"boolean"},"reason":{"type":"string","minLength":1,"maxLength":2048}}},
    "Descriptor": {"type":"object","additionalProperties":false,"required":["platform","authentication","capabilities","schemaRevision","configSchema","configDefaults"],"properties":{"platform":{"enum":["netease","qqmusic","applemusic"]},"authentication":{"enum":["anonymous","developerTokenRequired"]},"capabilities":{"type":"array","maxItems":6,"items":{"$ref":"#/$defs/Capability"},"minItems":6},"schemaRevision":{"const":"online-anonymous-v1"},"configSchema":{"const":{"type":"object","additionalProperties":false,"properties":{}}},"configDefaults":{"const":{}}}},
    "Manifest": {"type":"object","additionalProperties":false,"required":["pluginId","pluginVersion","protocolVersion","roles","capabilities","systems","architectures","maxMessageBytes","maxPageItems","configuration"],"properties":{"pluginId":{"enum":["musicfs.netease","musicfs.qqmusic","musicfs.applemusic"]},"pluginVersion":{"const":"0.1.0"},"protocolVersion":{"const":"1.0"},"roles":{"const":["provider"]},"capabilities":{"type":"array","maxItems":4,"items":{"enum":["search.tracks","metadata.track","playlist.observe","recommendations.playlists"]}},"systems":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":32},"minItems":1},"architectures":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":32},"minItems":1},"maxMessageBytes":{"const":1048576},"maxPageItems":{"const":50},"configuration":{"const":null}},"allOf":[{"if":{"properties":{"pluginId":{"const":"musicfs.netease"}}},"then":{"properties":{"capabilities":{"const":["search.tracks","metadata.track","playlist.observe","recommendations.playlists"]}}},"else":{"properties":{"capabilities":{"const":[]}}}}]},
    "Ready": {"type":"object","additionalProperties":false,"required":["manifest","instanceId","nonce"],"properties":{"manifest":{"$ref":"#/$defs/Manifest"},"instanceId":{"type":"string","minLength":1,"maxLength":128},"nonce":{"type":"string","pattern":"^[0-9a-f]{48}$"}}},
    "Track": {"type":"object","additionalProperties":false,"required":["externalId","title","artists","album","durationMs","sourceUrl","metadataDigest","playbackAvailability"],"properties":{"externalId":{"type":"string","pattern":"^[A-Za-z0-9]{1,64}$"},"title":{"type":"string","minLength":1,"maxLength":4096},"artists":{"type":"array","maxItems":128,"items":{"type":"string","minLength":1,"maxLength":4096}},"album":{"type":"string","minLength":0,"maxLength":4096},"durationMs":{"anyOf":[{"type":"null"},{"type":"integer","minimum":1,"maximum":604800000}]},"sourceUrl":{"type":"string","pattern":"^https://(?:music\\.163\\.com/song\\?id=[1-9][0-9]{0,19}|y\\.qq\\.com/n/ryqq/songDetail/[A-Za-z0-9]{1,64})$"},"metadataDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"playbackAvailability":{"const":"unknown"}}},
    "SearchPage": {"type":"object","additionalProperties":false,"required":["tracks","nextCursor","truncated","consistency","observedAt"],"properties":{"tracks":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/Track"}},"nextCursor":{"anyOf":[{"type":"null"},{"type":"string","minLength":1,"maxLength":1024,"pattern":"^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}]},"truncated":{"type":"boolean"},"consistency":{"const":"unversioned"},"observedAt":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"truncated":{"const":true}}},"then":{"properties":{"nextCursor":{"const":null}}}}]},
    "Playlist": {"type":"object","additionalProperties":false,"required":["externalId","title","sourceUrl","trackCount"],"properties":{"externalId":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},"title":{"type":"string","minLength":1,"maxLength":4096},"sourceUrl":{"type":"string","pattern":"^https://music\\.163\\.com/playlist\\?id=[1-9][0-9]{0,19}$"},"trackCount":{"anyOf":[{"type":"null"},{"type":"integer","minimum":0}]}}},
    "Entry": {"type":"object","additionalProperties":false,"required":["position","externalTrackId"],"properties":{"position":{"type":"integer","minimum":0,"maximum":9999},"externalTrackId":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}}},
    "Observation": {"type":"object","additionalProperties":false,"required":["playlist","entries","complete","consistency","metadataDigest","observedAt"],"properties":{"playlist":{"$ref":"#/$defs/Playlist"},"entries":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/Entry"}},"complete":{"type":"boolean"},"consistency":{"const":"unversioned"},"metadataDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"observedAt":{"type":"string","format":"date-time"}}},
    "Recommendation": {"type":"object","additionalProperties":false,"required":["playlist","position","reason"],"properties":{"playlist":{"$ref":"#/$defs/Playlist"},"position":{"type":"integer","minimum":0,"maximum":49},"reason":{"type":"string","minLength":0,"maxLength":4096}}},
    "RecommendationPage": {"type":"object","additionalProperties":false,"required":["items","personalized","nextCursor","observedAt","expiresAt"],"properties":{"items":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/Recommendation"}},"personalized":{"const":false},"nextCursor":{"const":null},"observedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"}}},
    "DescriptorResult": {"type":"object","additionalProperties":false,"required":["context","value"],"properties":{"context":{"$ref":"#/$defs/Context"},"value":{"$ref":"#/$defs/Descriptor"}}},
    "TrackResult": {"type":"object","additionalProperties":false,"required":["context","value"],"properties":{"context":{"$ref":"#/$defs/Context"},"value":{"$ref":"#/$defs/Track"}}},
    "SearchPageResult": {"type":"object","additionalProperties":false,"required":["context","value"],"properties":{"context":{"$ref":"#/$defs/Context"},"value":{"$ref":"#/$defs/SearchPage"}}},
    "ObservationResult": {"type":"object","additionalProperties":false,"required":["context","value"],"properties":{"context":{"$ref":"#/$defs/Context"},"value":{"$ref":"#/$defs/Observation"}}},
    "RecommendationPageResult": {"type":"object","additionalProperties":false,"required":["context","value"],"properties":{"context":{"$ref":"#/$defs/Context"},"value":{"$ref":"#/$defs/RecommendationPage"}}},
    "Request": {"oneOf":[{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"host.hello"},"params":{"$ref":"#/$defs/Hello"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.describe"},"params":{"$ref":"#/$defs/Scope"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.search"},"params":{"$ref":"#/$defs/Search"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.metadata"},"params":{"$ref":"#/$defs/Reference"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.playlist"},"params":{"$ref":"#/$defs/Reference"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.recommendations"},"params":{"$ref":"#/$defs/Recommendations"}}},{"type":"object","additionalProperties":false,"required":["jsonrpc","id","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"method":{"const":"provider.online.resolve"},"params":{"$ref":"#/$defs/Reference"}}}]},
    "Success": {"type":"object","additionalProperties":false,"required":["jsonrpc","id","result"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"result":{"oneOf":[{"$ref":"#/$defs/Ready"},{"$ref":"#/$defs/DescriptorResult"},{"$ref":"#/$defs/TrackResult"},{"$ref":"#/$defs/SearchPageResult"},{"$ref":"#/$defs/ObservationResult"},{"$ref":"#/$defs/RecommendationPageResult"}]}}},
    "Failure": {"type":"object","additionalProperties":false,"required":["jsonrpc","id","error"],"properties":{"jsonrpc":{"const":"2.0"},"id":{"type":"string","minLength":1,"maxLength":80},"error":{"type":"object","additionalProperties":false,"required":["code","message","data"],"properties":{"code":{"const":-32000},"message":{"type":"string","minLength":1,"maxLength":512},"data":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"enum":["INVALID_ARGUMENT","ACCESS_DENIED","AUTH_REQUIRED","NOT_FOUND","RATE_LIMITED","TEMPORARY_FAILURE","UNSUPPORTED","PROTOCOL_MISMATCH","CANCELED"]},"retryable":{"type":"boolean"},"retryAfterMs":{"type":"integer","minimum":1,"maximum":3600000}}}}}}},
    "Cancel": {"type":"object","additionalProperties":false,"required":["jsonrpc","method","params"],"properties":{"jsonrpc":{"const":"2.0"},"method":{"const":"$/cancelRequest"},"params":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string","minLength":1,"maxLength":80}}}}}
  }
}
