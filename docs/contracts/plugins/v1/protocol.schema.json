{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/plugins/v1/protocol.schema.json",
  "title": "MusicFS JSON-RPC 2.0 控制面 1.0",
  "oneOf": [{"$ref": "#/$defs/Request"}, {"$ref": "#/$defs/Success"}, {"$ref": "#/$defs/Failure"}, {"$ref": "#/$defs/Cancel"}],
  "$defs": {
    "ID": {"type": "string", "minLength": 1, "maxLength": 256},
    "RequestID": {"type": "string", "pattern": "^[hw]-[A-Za-z0-9_-]+$", "maxLength": 128},
    "Version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "Manifest": {
      "type": "object",
      "required": ["pluginId", "pluginVersion", "protocolVersion", "roles", "capabilities", "systems", "architectures", "maxMessageBytes", "maxPageItems"],
      "properties": {
        "pluginId": {"$ref": "#/$defs/ID"}, "pluginVersion": {"$ref": "#/$defs/Version"}, "protocolVersion": {"const": "1.0"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["provider", "audio", "scraper"]}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)+$"}},
        "systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows", "linux"]}},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["amd64", "arm64"]}},
        "maxMessageBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxPageItems": {"type": "integer", "minimum": 1, "maximum": 200},
        "maxInflightRequests": {"type": "integer", "minimum": 1, "maximum": 256},
        "configSchema": {"type": "object"}
      }
    },
    "Context": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "userId", "taskId", "timeoutMs"],
      "properties": {"instanceId": {"$ref": "#/$defs/ID"}, "userId": {"$ref": "#/$defs/ID"}, "taskId": {"$ref": "#/$defs/ID"}, "accountRef": {"$ref": "#/$defs/ID"}, "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 3600000}}
    },
    "Hello": {
      "type": "object", "additionalProperties": false, "required": ["protocolVersion", "instanceId", "nonce", "configRevision"],
      "properties": {"protocolVersion": {"const": "1.0"}, "instanceId": {"$ref": "#/$defs/ID"}, "nonce": {"$ref": "#/$defs/ID"}, "configRevision": {"$ref": "#/$defs/ID"}, "capabilities": {"$ref": "#/$defs/AudioCapabilities"}}
    },
    "Ready": {
      "type": "object", "required": ["manifest", "instanceId", "nonce"],
      "properties": {"manifest": {"$ref": "#/$defs/Manifest"}, "instanceId": {"$ref": "#/$defs/ID"}, "nonce": {"$ref": "#/$defs/ID"}}
    },
    "ScanRequest": {
      "type": "object", "additionalProperties": false, "required": ["rootId", "scanId", "generation", "limit"],
      "properties": {"rootId": {"$ref": "#/$defs/ID"}, "scanId": {"$ref": "#/$defs/ID"}, "generation": {"type": "integer", "minimum": 1}, "cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}}
    },
    "Observation": {
      "type": "object", "required": ["externalId", "rootId", "relativePath", "sourceRef", "observedVersion", "displayName", "sizeBytes", "mime", "codec", "durationMs", "bitrateBps", "bitrateMode", "providerSha512"],
      "properties": {
        "externalId": {"$ref": "#/$defs/ID"}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"},
        "sourceRef": {"$ref": "#/$defs/ID"}, "observedVersion": {"$ref": "#/$defs/ID"}, "displayName": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 0}, "mime": {"type": "string"}, "codec": {"type": ["string", "null"]},
        "durationMs": {"type": ["integer", "null"], "minimum": 0}, "bitrateBps": {"type": ["integer", "null"], "minimum": 1},
        "bitrateMode": {"enum": [null, "cbr", "vbr", "unknown"]},
        "providerSha512": {"type": ["string", "null"], "pattern": "^[a-f0-9]{128}$", "description": "Provider 对完整原文件的申报摘要；Host 不将其视为已验证摘要。"}
      }
    },
    "ScanPage": {
      "type": "object", "required": ["scanId", "generation", "page", "items", "complete", "rootIdentity", "issues"],
      "properties": {
        "scanId": {"$ref": "#/$defs/ID"}, "generation": {"type": "integer", "minimum": 1}, "page": {"type": "integer", "minimum": 0},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Observation"}, "maxItems": 200}, "nextCursor": {"type": "string"},
        "complete": {"type": "boolean"}, "rootIdentity": {"$ref": "#/$defs/ID"}, "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ResolveRequest": {
      "type": "object", "additionalProperties": false, "required": ["externalId", "expectedVersion"],
      "properties": {"externalId": {"$ref": "#/$defs/ID"}, "expectedVersion": {"$ref": "#/$defs/ID"}}
    },
    "RelativePath": {"type": "string", "minLength": 1, "not": {"anyOf": [{"pattern": "^[A-Za-z]:"}, {"pattern": "^[/\\\\]"}, {"pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"}]}},
    "Resource": {
      "type": "object", "required": ["resourceRef", "rootId", "relativePath", "observedVersion", "sizeBytes", "mime", "range"],
      "properties": {
        "resourceRef": {"$ref": "#/$defs/ID"}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"},
        "observedVersion": {"$ref": "#/$defs/ID"}, "sizeBytes": {"type": "integer", "minimum": 0}, "mime": {"type": "string", "minLength": 1}, "range": {"type": "boolean"}
      }
    },
    "EntriesRequest": {
      "type": "object", "additionalProperties": false, "required": ["rootId", "limit"],
      "properties": {"rootId": {"$ref": "#/$defs/ID"}, "cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}}
    },
    "Entry": {
      "type": "object", "required": ["rootId", "relativePath", "fileIdentity", "observedVersion", "sizeBytes", "mime", "durationMs"],
      "properties": {"rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"}, "fileIdentity": {"$ref": "#/$defs/ID"}, "observedVersion": {"$ref": "#/$defs/ID"}, "sizeBytes": {"type": "integer", "minimum": 0}, "mime": {"type": "string"}, "durationMs": {"type": ["integer", "null"], "minimum": 0}}
    },
    "EntriesPage": {
      "type": "object", "required": ["items", "rootIdentity", "issues"],
      "properties": {"items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/Entry"}}, "nextCursor": {"type": "string"}, "rootIdentity": {"$ref": "#/$defs/ID"}, "issues": {"type": "array", "items": {"type": "string"}}}
    },
    "StateKey": {"type": "string", "pattern": "^[a-z0-9_-]{1,80}$"},
    "StateBytes": {"type": "string", "maxLength": 699052, "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/]*={0,2}$", "description": "不超过 512 KiB 的实例状态字节，按 Go []byte JSON 编码；不允许音频或文件正文。"},
    "StateGet": {"type": "object", "additionalProperties": false, "required": ["key", "revision"], "properties": {"key": {"$ref": "#/$defs/StateKey"}, "revision": {"const": 0}}},
    "StateCAS": {"type": "object", "additionalProperties": false, "required": ["key", "revision"], "properties": {"key": {"$ref": "#/$defs/StateKey"}, "revision": {"type": "integer", "minimum": 0}, "value": {"$ref": "#/$defs/StateBytes"}}},
    "StateResult": {"type": "object", "required": ["revision"], "properties": {"revision": {"type": "integer", "minimum": 0}, "value": {"$ref": "#/$defs/StateBytes"}}},
    "ResourceRequest": {
      "type": "object", "additionalProperties": false, "required": ["rootId", "relativePath", "observedVersion"],
      "properties": {"resourceRef": {"const": ""}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"}, "observedVersion": {"$ref": "#/$defs/ID"}, "sizeBytes": {"const": 0}, "mime": {"const": ""}, "range": {"const": false}}
    },
    "PCMFormat": {
      "type": "object", "required": ["sampleFormat", "sampleRate", "channels", "layout"],
      "properties": {"sampleFormat": {"const": "f32le"}, "sampleRate": {"const": 48000}, "channels": {"const": 2}, "layout": {"const": "stereo"}}
    },
    "AudioProfile": {
      "type": "object", "required": ["id", "mime", "codec", "container", "sampleRate", "channels", "bitrateBps", "seekMode"],
      "properties": {"id": {"const": "mp3-128"}, "mime": {"const": "audio/mpeg"}, "codec": {"const": "mp3"}, "container": {"const": "mp3"}, "sampleRate": {"const": 48000}, "channels": {"const": 2}, "bitrateBps": {"const": 128000}, "seekMode": {"const": "timeRestart"}}
    },
    "SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "AudioCapabilities": {
      "type": "object", "required": ["version", "build", "ffmpegSHA256", "ffprobeSHA256", "profiles", "pcm"],
      "properties": {"version": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}, "ffmpegSHA256": {"$ref": "#/$defs/SHA256"}, "ffprobeSHA256": {"$ref": "#/$defs/SHA256"}, "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/AudioProfile"}}, "pcm": {"$ref": "#/$defs/PCMFormat"}}
    },
    "AudioPlan": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "profile", "gainDB", "positionMs"],
      "properties": {"taskId": {"$ref": "#/$defs/ID"}, "assetId": {"$ref": "#/$defs/ID"}, "profile": {"const": "mp3-128"}, "gainDB": {"type": "number", "minimum": -60, "maximum": 0}, "positionMs": {"type": "integer", "minimum": 0, "maximum": 86400000}}
    },
    "TaskChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/[a-f0-9]{48}/(input|output)$", "description": "仅宿主创建的短期任务通道；不得记日志或交给浏览器。"},
    "AudioStart": {
      "type": "object", "additionalProperties": false, "required": ["plan", "ffmpegPath", "ffmpegSHA256", "inputUrl", "outputUrl"],
      "properties": {"plan": {"$ref": "#/$defs/AudioPlan"}, "ffmpegPath": {"type": "string", "minLength": 1}, "ffmpegSHA256": {"$ref": "#/$defs/SHA256"}, "inputUrl": {"$ref": "#/$defs/TaskChannel"}, "outputUrl": {"$ref": "#/$defs/TaskChannel"}}
    },
    "AudioPrepared": {"type": "object", "required": ["profile", "positionOriginMs", "seekMode"], "properties": {"profile": {"const": "mp3-128"}, "positionOriginMs": {"type": "integer", "minimum": 0}, "seekMode": {"const": "timeRestart"}}},
    "AudioComplete": {"type": "object", "required": ["state"], "properties": {"state": {"const": "complete"}}},
    "NCMID": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[!-~]+$", "not": {"pattern": "[/\\\\?#]"}},
    "NCMNonce": {"type": "string", "pattern": "^[a-f0-9]{48}$"},
    "NCMInputChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/[a-f0-9]{48}/input$", "description": "运行时还须校验端口不超过 65535，并与 nonce 完全绑定。"},
    "NCMOutputChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/[a-f0-9]{48}/output$", "description": "运行时还须校验端口不超过 65535，并与 nonce 完全绑定。"},
    "NCMOpen": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "nonce", "inputUrl", "size"],
      "properties": {
        "taskId": {"allOf": [{"$ref": "#/$defs/NCMID"}, {"maxLength": 196}]}, "assetId": {"$ref": "#/$defs/NCMID"},
        "nonce": {"$ref": "#/$defs/NCMNonce"}, "inputUrl": {"$ref": "#/$defs/NCMInputChannel"}, "size": {"type": "integer", "minimum": 1}
      }
    },
    "NCMMetadata": {
      "type": "object", "additionalProperties": false, "required": ["format", "mime"],
      "properties": {
        "format": {"enum": ["mp3", "flac"]}, "mime": {"enum": ["audio/mpeg", "audio/flac"]},
        "title": {"type": "string", "maxLength": 4096}, "album": {"type": "string", "maxLength": 4096},
        "artists": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "durationMs": {"type": "integer", "minimum": 1}, "bitrateBps": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {"properties": {"format": {"const": "mp3"}, "mime": {"const": "audio/mpeg"}}},
        {"properties": {"format": {"const": "flac"}, "mime": {"const": "audio/flac"}}}
      ]
    },
    "NCMOpened": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "nonce", "outputUrl", "size", "metadata"],
      "properties": {
        "taskId": {"allOf": [{"$ref": "#/$defs/NCMID"}, {"maxLength": 196}]}, "assetId": {"$ref": "#/$defs/NCMID"},
        "nonce": {"$ref": "#/$defs/NCMNonce"}, "outputUrl": {"$ref": "#/$defs/NCMOutputChannel"},
        "size": {"type": "integer", "minimum": 1}, "metadata": {"$ref": "#/$defs/NCMMetadata"}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"],
      "properties": {"jsonrpc": {"const": "2.0"}, "id": {"$ref": "#/$defs/RequestID"}, "method": {"type": "string"}, "params": {"type": "object"}},
      "oneOf": [
        {"properties": {"method": {"const": "host.hello"}, "params": {"$ref": "#/$defs/Hello"}}},
        {"properties": {"method": {"const": "provider.scan"}, "params": {"$ref": "#/$defs/ScanRequest"}}},
        {"properties": {"method": {"enum": ["provider.resolve", "provider.metadata"]}, "params": {"$ref": "#/$defs/ResolveRequest"}}},
        {"properties": {"method": {"const": "host.entries"}, "params": {"$ref": "#/$defs/EntriesRequest"}}},
        {"properties": {"method": {"const": "host.state.get"}, "params": {"$ref": "#/$defs/StateGet"}}},
        {"properties": {"method": {"const": "host.state.compareAndSet"}, "params": {"$ref": "#/$defs/StateCAS"}}},
        {"properties": {"method": {"const": "host.resource"}, "params": {"$ref": "#/$defs/ResourceRequest"}}},
        {"properties": {"method": {"const": "audio.describe"}, "params": {"type": "object", "maxProperties": 0}}},
        {"properties": {"method": {"enum": ["audio.prepare", "audio.start"]}, "params": {"$ref": "#/$defs/AudioStart"}}},
        {"properties": {"method": {"const": "ncm.open"}, "params": {"$ref": "#/$defs/NCMOpen"}}}
      ]
    },
    "Success": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"],
      "properties": {"jsonrpc": {"const": "2.0"}, "id": {"$ref": "#/$defs/RequestID"}, "result": {"anyOf": [{"$ref": "#/$defs/Ready"}, {"$ref": "#/$defs/ScanPage"}, {"$ref": "#/$defs/Resource"}, {"$ref": "#/$defs/Observation"}, {"$ref": "#/$defs/StateResult"}, {"$ref": "#/$defs/EntriesPage"}, {"$ref": "#/$defs/AudioCapabilities"}, {"$ref": "#/$defs/AudioPrepared"}, {"$ref": "#/$defs/AudioComplete"}, {"$ref": "#/$defs/NCMOpened"}]}}
    },
    "ErrorData": {
      "type": "object", "required": ["code", "retryable"],
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENT", "AUTH_REQUIRED", "ACCESS_DENIED", "NOT_FOUND", "UNSUPPORTED", "SOURCE_OFFLINE", "RESOURCE_CHANGED", "RATE_LIMITED", "TEMPORARY_FAILURE", "CANCELED", "PROTOCOL_MISMATCH", "CONFLICT"]},
        "retryable": {"type": "boolean"}, "retryAfterMs": {"type": "integer", "minimum": 0}
      }
    },
    "Failure": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"}, "id": {"anyOf": [{"$ref": "#/$defs/RequestID"}, {"type": "null"}]},
        "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"enum": [-32700, -32600, -32601, -32602, -32603, -32000]}, "message": {"type": "string", "minLength": 1}, "data": {"$ref": "#/$defs/ErrorData"}}}
      }
    },
    "Cancel": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"],
      "properties": {"jsonrpc": {"const": "2.0"}, "method": {"const": "$/cancelRequest"}, "params": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/RequestID"}}}}
    }
  }
}
