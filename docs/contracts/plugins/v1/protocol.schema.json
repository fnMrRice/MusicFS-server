{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/plugins/v1/protocol.schema.json",
  "title": "MusicFS JSON-RPC 2.0 控制面 1.0",
  "oneOf": [{"$ref": "#/$defs/Request"}, {"$ref": "#/$defs/Success"}, {"$ref": "#/$defs/Failure"}, {"$ref": "#/$defs/Cancel"}],
  "$defs": {
    "PluginDisplayCount": {"type":"object","additionalProperties":false,"required":["value","unit","localizedUnits"],"properties":{"value":{"type":"integer","minimum":0,"maximum":9007199254740991},"unit":{"type":"string","minLength":1,"maxLength":128},"localizedUnits":{"type":"object","maxProperties":64,"propertyNames":{"type":"string","maxLength":63,"pattern":"^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":128}}}},
    "DisplayCountRequest": {"type":"object","additionalProperties":false,"required":["instanceId","rootIds"],"properties":{"instanceId":{"$ref":"#/$defs/InstanceID"},"rootIds":{"type":"array","maxItems":1024,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}}}},
    "InstanceID": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"const": "00000000-0000-0000-0000-000000000000"}},
    "PluginIdentity": {"type":"object","additionalProperties":false,"required":["id","name","localizedNames","features"],"properties":{"id":{"type":"string","minLength":1,"maxLength":128},"name":{"type":"string","minLength":1,"maxLength":128},"localizedNames":{"type":"object","maxProperties":64,"propertyNames":{"type":"string","maxLength":63,"pattern":"^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"},"additionalProperties":{"type":"string","minLength":1,"maxLength":128}},"features":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"}}}},
    "ScrapeRef": {"type": "string", "pattern": "^[0-9a-f]{48}$"},
    "ScrapeTarget": {"type": "object", "additionalProperties": false, "required": ["sourceTrackId", "assetId", "assetVersion", "revision"], "properties": {"sourceTrackId": {"type": "string", "minLength": 1, "maxLength": 128}, "assetId": {"type": "string", "minLength": 1, "maxLength": 128}, "assetVersion": {"type": "string", "minLength": 1, "maxLength": 1024}, "revision": {"type": "integer", "minimum": 0}}},
    "ScrapeContext": {"type": "object", "additionalProperties": false, "required": ["instanceId", "userId", "taskId", "timeoutMs"], "properties": {"instanceId": {"$ref": "#/$defs/InstanceID"}, "userId": {"type": "string", "minLength": 1, "maxLength": 128}, "taskId": {"type": "string", "minLength": 1, "maxLength": 128}, "accountRef": {"const": ""}, "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 30000}}},
    "ScrapeQuery": {"type": "object", "additionalProperties": false, "required": ["title", "artists"], "properties": {"title": {"type": "string", "minLength": 0, "maxLength": 4096}, "artists": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"type": "string", "minLength": 0, "maxLength": 1024}}}},
    "ScrapeResource": {"type": "object", "additionalProperties": false, "required": ["resourceRef", "version", "kind", "sizeBytes", "match"], "properties": {"resourceRef": {"$ref": "#/$defs/ScrapeRef"}, "version": {"type": "string", "minLength": 1, "maxLength": 1024}, "kind": {"enum": ["audio", "lyrics", "artwork"]}, "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 8796093022208}, "match": {"enum": ["embedded", "exactStem", "directoryCover"]}}, "allOf": [{"if": {"properties": {"kind": {"const": "audio"}}}, "then": {"properties": {"match": {"const": "embedded"}}}, "else": {"properties": {"match": {"enum": ["exactStem", "directoryCover"]}}}}, {"if": {"properties": {"kind": {"const": "lyrics"}}}, "then": {"properties": {"match": {"const": "exactStem"}}}}]},
    "ScrapeHello": {"type": "object", "additionalProperties": false, "required": ["protocolVersion", "instanceId", "nonce", "configRevision", "context", "target", "baseUrl"], "properties": {"protocolVersion": {"const": "1.0"}, "instanceId": {"$ref": "#/$defs/InstanceID"}, "nonce": {"$ref": "#/$defs/ScrapeRef"}, "configRevision": {"const": "1"}, "context": {"$ref": "#/$defs/ScrapeContext"}, "target": {"$ref": "#/$defs/ScrapeTarget"}, "baseUrl": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/[0-9a-f]{48}$"}}},
    "ScrapeSearch": {"type": "object", "additionalProperties": false, "required": ["context", "target", "fields", "languages", "resources"], "properties": {"context": {"$ref": "#/$defs/ScrapeContext"}, "target": {"$ref": "#/$defs/ScrapeTarget"}, "fields": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["lyrics", "artwork"]}, "uniqueItems": true}, "languages": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 35}}, "query": {"$ref": "#/$defs/ScrapeQuery"}, "resources": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"$ref": "#/$defs/ScrapeResource"}}}},
    "ScrapeCandidate": {"type": "object", "additionalProperties": false, "required": ["candidateId", "target", "field", "language", "format", "mime", "sizeBytes", "sha256", "origin", "resourceRef", "resourceVersion", "basis", "status", "failureCode"], "properties": {"candidateId": {"$ref": "#/$defs/ScrapeRef"}, "target": {"$ref": "#/$defs/ScrapeTarget"}, "field": {"enum": ["lyrics", "artwork"]}, "language": {"type": "string", "minLength": 0, "maxLength": 35}, "format": {"enum": ["", "text", "lrc", "png", "jpeg"]}, "mime": {"enum": ["", "text/plain; charset=utf-8", "image/png", "image/jpeg"]}, "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 8388608}, "sha256": {"type": "string", "pattern": "^(?:[0-9a-f]{64})?$"}, "origin": {"enum": ["embedded", "sidecar"]}, "resourceRef": {"$ref": "#/$defs/ScrapeRef"}, "resourceVersion": {"type": "string", "minLength": 1, "maxLength": 1024}, "basis": {"type": "string", "minLength": 0, "maxLength": 64}, "status": {"enum": ["available", "unavailable"]}, "failureCode": {"enum": [null, "UNSUPPORTED"]}}, "allOf": [{"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"properties": {"format": {"const": ""}, "mime": {"const": ""}, "sha256": {"const": ""}, "sizeBytes": {"const": 0}, "failureCode": {"const": "UNSUPPORTED"}}}, "else": {"properties": {"sizeBytes": {"minimum": 1}, "sha256": {"$ref": "#/$defs/SHA256"}, "failureCode": {"type": "null"}}, "oneOf": [{"properties": {"field": {"const": "lyrics"}, "format": {"enum": ["text", "lrc"]}, "mime": {"const": "text/plain; charset=utf-8"}, "sizeBytes": {"maximum": 1048576}}}, {"properties": {"field": {"const": "artwork"}, "format": {"const": "png"}, "mime": {"const": "image/png"}}}, {"properties": {"field": {"const": "artwork"}, "format": {"const": "jpeg"}, "mime": {"const": "image/jpeg"}}}]}}]},
    "ScrapeIssue": {"type": "object", "additionalProperties": false, "required": ["resourceRef", "code"], "properties": {"resourceRef": {"$ref": "#/$defs/ScrapeRef"}, "code": {"enum": ["UNSUPPORTED", "RESOURCE_CHANGED"]}}},
    "ScrapeSearchResult": {"type": "object", "additionalProperties": false, "required": ["candidates", "issues"], "properties": {"candidates": {"type": "array", "minItems": 0, "maxItems": 64, "items": {"$ref": "#/$defs/ScrapeCandidate"}}, "issues": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"$ref": "#/$defs/ScrapeIssue"}}}},
    "ScrapeFetch": {"type": "object", "additionalProperties": false, "required": ["context", "target", "candidateId", "outputRef"], "properties": {"context": {"$ref": "#/$defs/ScrapeContext"}, "target": {"$ref": "#/$defs/ScrapeTarget"}, "candidateId": {"$ref": "#/$defs/ScrapeRef"}, "outputRef": {"$ref": "#/$defs/ScrapeRef"}}},
    "ScrapeFetchResult": {"type": "object", "additionalProperties": false, "required": ["candidate", "contentRef"], "properties": {"candidate": {"$ref": "#/$defs/ScrapeCandidate"}, "contentRef": {"$ref": "#/$defs/ScrapeRef"}}},
    "AudioNormalize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "ffmpegPath",
        "ffmpegSHA256",
        "inputUrl",
        "outputUrl"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/AudioNormalizePlan"
        },
        "ffmpegPath": {
          "type": "string",
          "minLength": 1
        },
        "ffmpegSHA256": {
          "$ref": "#/$defs/SHA256"
        },
        "inputUrl": {
          "$ref": "#/$defs/TaskChannel"
        },
        "outputUrl": {
          "$ref": "#/$defs/TaskChannel"
        }
      }
    },
    "NormalizedPCMInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "normalizationRevision",
        "startSample",
        "sampleCount",
        "decoderVersion",
        "decoderSHA256"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/FingerprintPCMFormat"
        },
        "normalizationRevision": {
          "const": "s16le-mono-11025-floor-range-v1"
        },
        "startSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 952560000
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1323000
        },
        "decoderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decoderSHA256": {
          "$ref": "#/$defs/SHA256"
        }
      },
      "description": "DSP 前的固定 PCM 描述；实际尾段可短于请求。宿主同时校验两端点量化后的范围、实际字节数与工具版本/摘要，不接受补零伪造覆盖。"
    },
    "FingerprintPCMFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleFormat",
        "sampleRate",
        "channels",
        "layout"
      ],
      "properties": {
        "sampleFormat": {
          "const": "s16le"
        },
        "sampleRate": {
          "const": 11025
        },
        "channels": {
          "const": 1
        },
        "layout": {
          "const": "mono"
        }
      }
    },
    "AudioNormalizePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "assetId",
        "startMs",
        "durationMs"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 120000
        }
      }
    },
    "ScanScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "rootIdentity",
        "recursive",
        "maxDepth",
        "excludePatterns"
      ],
      "properties": {
        "rootId": {
          "$ref": "#/$defs/ID"
        },
        "rootIdentity": {
          "$ref": "#/$defs/ID"
        },
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "开启递归时 0 表示不限深度，1—64 表示最多进入的子目录层数；关闭递归时只能为 0。"
        },
        "skipHidden": {"type": "boolean", "description": "跳过点开头条目和 Windows 隐藏文件、目录。"},
        "respectNoMedia": {"type": "boolean", "description": "遵循 .nomedia 标记，跳过所在目录及子目录。"},
        "excludePatterns": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "根相对 / 路径，*、? 和独立段 **；大小写敏感。匹配目录排除整支。运行时另验证UTF-8字节上限、禁止绝对/点路径、反斜线、字符类和否定。"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 0
          }
        }
      },
      "else": {
        "properties": {
          "maxDepth": {
            "const": 0
          }
        }
      }
    },
    "PluginConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRevision",
        "importOptionsSchema",
        "importDefaults",
        "unavailableOptions"
      ],
      "properties": {
        "schemaRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "importOptionsSchema": {
          "allOf": [
            {
              "$ref": "#/$defs/ImportOptionSchema"
            },
            {
              "required": [
                "type",
                "additionalProperties"
              ],
              "properties": {
                "type": {
                  "const": "object"
                },
                "additionalProperties": {
                  "const": false
                }
              }
            }
          ]
        },
        "importDefaults": {
          "$ref": "#/$defs/ImportOptions"
        },
        "unavailableOptions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "reason"
            ],
            "properties": {
              "code": {
                "const": "UNSUPPORTED"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "ImportOptionSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "boolean",
            "integer",
            "string",
            "array"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ImportOptionSchema"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "default": {
          "anyOf": [
            {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            },
            {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          ]
        },
        "const": {
          "anyOf": [
            {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            },
            {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          ]
        },
        "enum": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "if": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "then": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "else": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "items": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "uniqueItems": {
          "const": true
        }
      },
      "maxProperties": 20,
      "description": "受限本地 JSON Schema；运行时另限制 32 KiB 与 8 层。禁止 $ref、脚本、HTML 执行和未知关键字。"
    },
    "ImportOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "开启递归时 0 表示不限深度，1—64 表示最多进入的子目录层数；关闭递归时只能为 0。"
        },
        "importLyrics": {
          "type": "boolean"
        },
        "skipHidden": {"type": "boolean", "description": "跳过点开头条目和 Windows 隐藏文件、目录。"},
        "respectNoMedia": {"type": "boolean", "description": "遵循 .nomedia 标记，跳过所在目录及子目录。"},
        "excludePatterns": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "根相对 / 路径，*、? 和独立段 **；大小写敏感。匹配目录排除整支。运行时另验证UTF-8字节上限、禁止绝对/点路径、反斜线、字符类和否定。"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        },
        "required": [
          "recursive"
        ]
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 0
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "recursive"
          ]
        },
        "then": {
          "properties": {
            "maxDepth": {
              "const": 0
            }
          }
        }
      },
      "description": "部分覆盖；关闭且未给深度规范为 0；从关闭切换开启且未给深度恢复 0；开启递归时 0 表示不限深度，1—64 表示子目录层数。null 与未知字段拒绝。importLyrics=true 在成功扫描后独立触发本地歌词导入，只补充缺失且未锁定的内容。"
    },
    "ImportOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recursive",
        "maxDepth",
        "importLyrics",
        "excludePatterns"
      ],
      "properties": {
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "开启递归时 0 表示不限深度，1—64 表示最多进入的子目录层数；关闭递归时只能为 0。"
        },
        "importLyrics": {
          "type": "boolean"
        },
        "skipHidden": {"type": "boolean", "description": "跳过点开头条目和 Windows 隐藏文件、目录。"},
        "respectNoMedia": {"type": "boolean", "description": "遵循 .nomedia 标记，跳过所在目录及子目录。"},
        "excludePatterns": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "根相对 / 路径，*、? 和独立段 **；大小写敏感。匹配目录排除整支。运行时另验证UTF-8字节上限、禁止绝对/点路径、反斜线、字符类和否定。"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 0
          }
        }
      },
      "else": {
        "properties": {
          "maxDepth": {
            "const": 0
          }
        }
      }
    },
    "ID": {"type": "string", "minLength": 1, "maxLength": 256},
    "RequestID": {"type": "string", "pattern": "^[hw]-[A-Za-z0-9_-]+$", "maxLength": 128},
    "Version": {"type":"string","minLength":5,"maxLength":128,"pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "Manifest": {
      "type": "object",
      "required": [
        "plugin",
        "supportsMultipleInstances",
        "pluginId",
        "pluginVersion",
        "protocolVersion",
        "roles",
        "capabilities",
        "systems",
        "architectures",
        "maxMessageBytes",
        "maxPageItems",
        "configuration"
      ],
      "properties": {
        "plugin": {"$ref": "#/$defs/PluginIdentity"},
        "supportsMultipleInstances": {"type": "boolean", "default": false},
        "pluginId": {
          "$ref": "#/$defs/ID"
        },
        "pluginVersion": {
          "$ref": "#/$defs/Version"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "provider",
              "audio",
              "scraper"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)+$"
          }
        },
        "systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "linux"
            ]
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxPageItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxInflightRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginConfiguration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Context": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "userId", "taskId", "timeoutMs"],
      "properties": {"instanceId": {"$ref": "#/$defs/InstanceID"}, "userId": {"$ref": "#/$defs/ID"}, "taskId": {"$ref": "#/$defs/ID"}, "accountRef": {"$ref": "#/$defs/ID"}, "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 3600000}}
    },
    "Hello": {
      "type": "object", "additionalProperties": false, "required": ["protocolVersion", "instanceId", "nonce", "configRevision"],
      "properties": {"protocolVersion": {"const": "1.0"}, "instanceId": {"$ref": "#/$defs/InstanceID"}, "nonce": {"$ref": "#/$defs/ID"}, "configRevision": {"$ref": "#/$defs/ID"}, "taskId": {"$ref": "#/$defs/ID", "description": "单次解码器任务握手必填；独立于配置实例 UUID。"}, "capabilities": {"$ref": "#/$defs/AudioCapabilities"}}
    },
    "DecoderHello": {"allOf": [{"$ref": "#/$defs/Hello"}], "required": ["taskId"]},
    "Ready": {
      "type": "object", "required": ["manifest", "instanceId", "nonce"],
      "properties": {"manifest": {"$ref": "#/$defs/Manifest"}, "instanceId": {"$ref": "#/$defs/InstanceID"}, "nonce": {"$ref": "#/$defs/ID"}}
    },
    "ScanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "scanId",
        "generation",
        "limit",
        "scope",
        "planDigest",
        "grantId"
      ],
      "properties": {
        "rootId": {
          "$ref": "#/$defs/ID"
        },
        "scanId": {
          "$ref": "#/$defs/ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "scope": {
          "$ref": "#/$defs/ScanScope"
        },
        "planDigest": {
          "$ref": "#/$defs/SHA256"
        },
        "grantId": {
          "$ref": "#/$defs/ID"
        }
      }
    },
    "Observation": {
      "type": "object", "required": ["externalId", "rootId", "relativePath", "sourceRef", "observedVersion", "displayName", "sizeBytes", "mime", "codec", "durationMs", "bitrateBps", "bitrateMode", "providerSha512"],
      "properties": {
        "externalId": {"$ref": "#/$defs/ID"}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"},
        "sourceRef": {"$ref": "#/$defs/ID"}, "observedVersion": {"$ref": "#/$defs/ID"}, "displayName": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 0}, "mime": {"type": "string"}, "codec": {"type": ["string", "null"]},
        "durationMs": {"type": ["integer", "null"], "minimum": 0}, "bitrateBps": {"type": ["integer", "null"], "minimum": 1},
        "bitrateMode": {"enum": [null, "cbr", "vbr", "unknown"]},
        "providerSha512": {"type": ["string", "null"], "pattern": "^[a-f0-9]{128}$", "description": "Provider 对完整原文件的申报摘要；Host 不将其视为已验证摘要。"}
      }
    },
    "ScanPage": {
      "type": "object",
      "required": [
        "scanId",
        "generation",
        "page",
        "items",
        "complete",
        "rootIdentity",
        "issues",
        "planDigest"
      ],
      "properties": {
        "scanId": {
          "$ref": "#/$defs/ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 200
        },
        "nextCursor": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "rootIdentity": {
          "$ref": "#/$defs/ID"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planDigest": {
          "$ref": "#/$defs/SHA256"
        }
      }
    },
    "ResolveRequest": {
      "type": "object", "additionalProperties": false, "required": ["externalId", "expectedVersion"],
      "properties": {"externalId": {"$ref": "#/$defs/ID"}, "expectedVersion": {"$ref": "#/$defs/ID"}}
    },
    "RelativePath": {"type": "string", "minLength": 1, "not": {"anyOf": [{"pattern": "^[A-Za-z]:"}, {"pattern": "^[/\\\\]"}, {"pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"}]}},
    "Resource": {
      "type": "object", "required": ["resourceRef", "rootId", "relativePath", "observedVersion", "sizeBytes", "mime", "range"],
      "properties": {
        "resourceRef": {"$ref": "#/$defs/ID"}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"},
        "observedVersion": {"$ref": "#/$defs/ID"}, "sizeBytes": {"type": "integer", "minimum": 0}, "mime": {"type": "string", "minLength": 1}, "range": {"type": "boolean"}
      }
    },
    "EntriesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "limit",
        "grantId"
      ],
      "properties": {
        "rootId": {
          "$ref": "#/$defs/ID"
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "grantId": {
          "$ref": "#/$defs/ID"
        }
      }
    },
    "Entry": {
      "type": "object",
      "required": [
        "rootId",
        "relativePath",
        "fileIdentity",
        "observedVersion",
        "sizeBytes",
        "mime",
        "durationMs",
        "linkCount"
      ],
      "properties": {
        "rootId": {
          "$ref": "#/$defs/ID"
        },
        "relativePath": {
          "$ref": "#/$defs/RelativePath"
        },
        "fileIdentity": {
          "$ref": "#/$defs/ID"
        },
        "observedVersion": {
          "$ref": "#/$defs/ID"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "linkCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "EntriesPage": {
      "type": "object", "required": ["items", "rootIdentity", "issues"],
      "properties": {"items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/Entry"}}, "nextCursor": {"type": "string"}, "rootIdentity": {"$ref": "#/$defs/ID"}, "issues": {"type": "array", "items": {"type": "string"}}}
    },
    "StateKey": {"type": "string", "pattern": "^[a-z0-9_-]{1,80}$"},
    "StateBytes": {"type": "string", "maxLength": 699052, "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/]*={0,2}$", "description": "不超过 512 KiB 的实例状态字节，按 Go []byte JSON 编码；不允许音频或文件正文。"},
    "StateGet": {"type": "object", "additionalProperties": false, "required": ["key", "revision"], "properties": {"key": {"$ref": "#/$defs/StateKey"}, "revision": {"const": 0}}},
    "StateCAS": {"type": "object", "additionalProperties": false, "required": ["key", "revision"], "properties": {"key": {"$ref": "#/$defs/StateKey"}, "revision": {"type": "integer", "minimum": 0}, "value": {"$ref": "#/$defs/StateBytes"}}},
    "StateResult": {"type": "object", "required": ["revision"], "properties": {"revision": {"type": "integer", "minimum": 0}, "value": {"$ref": "#/$defs/StateBytes"}}},
    "ResourceRequest": {
      "type": "object", "additionalProperties": false, "required": ["rootId", "relativePath", "observedVersion"],
      "properties": {"resourceRef": {"const": ""}, "rootId": {"$ref": "#/$defs/ID"}, "relativePath": {"$ref": "#/$defs/RelativePath"}, "observedVersion": {"$ref": "#/$defs/ID"}, "sizeBytes": {"const": 0}, "mime": {"const": ""}, "range": {"const": false}}
    },
    "PCMFormat": {
      "type": "object", "required": ["sampleFormat", "sampleRate", "channels", "layout"],
      "properties": {"sampleFormat": {"const": "f32le"}, "sampleRate": {"const": 48000}, "channels": {"const": 2}, "layout": {"const": "stereo"}}
    },
    "AudioProfile": {
      "type": "object", "required": ["id", "mime", "codec", "container", "sampleRate", "channels", "bitrateBps", "seekMode"],
      "properties": {"id": {"const": "mp3-128"}, "mime": {"const": "audio/mpeg"}, "codec": {"const": "mp3"}, "container": {"const": "mp3"}, "sampleRate": {"const": 48000}, "channels": {"const": 2}, "bitrateBps": {"const": 128000}, "seekMode": {"const": "timeRestart"}}
    },
    "SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "AudioCapabilities": {
      "type": "object",
      "required": [
        "version",
        "build",
        "ffmpegSHA256",
        "ffprobeSHA256",
        "profiles",
        "pcm",
        "normalization"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "ffmpegSHA256": {
          "$ref": "#/$defs/SHA256"
        },
        "ffprobeSHA256": {
          "$ref": "#/$defs/SHA256"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AudioProfile"
          }
        },
        "pcm": {
          "$ref": "#/$defs/PCMFormat"
        },
        "normalization": {
          "type": "boolean"
        }
      }
    },
    "AudioPlan": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "profile", "gainDB", "positionMs"],
      "properties": {"taskId": {"$ref": "#/$defs/ID"}, "assetId": {"$ref": "#/$defs/ID"}, "profile": {"const": "mp3-128"}, "gainDB": {"type": "number", "minimum": -60, "maximum": 0}, "positionMs": {"type": "integer", "minimum": 0, "maximum": 86400000}}
    },
    "TaskChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/[a-f0-9]{48}/(input|output)$", "description": "仅宿主创建的短期任务通道；不得记日志或交给浏览器。"},
    "DSPNodeSpec": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "version": {"const": 1},
        "params": {"type": "object", "maxProperties": 64, "propertyNames": {"minLength": 1, "maxLength": 64}, "additionalProperties": {"type": "number"}}
      },
      "description": "有序、无状态的 DSP v1 节点。宿主继续检查名称已注册、参数含义及外部进程的格式/时标声明；内建 gain 使用 gainDB，范围 -96 到 12。"
    },
    "DSPPlugin": {
      "type": "object", "additionalProperties": false, "required": ["name", "executable", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "not": {"enum": ["gain", "bypass"]}},
        "executable": {"type": "string", "minLength": 1, "description": "仅部署配置可指定；发送给音频 Worker 前已解析为绝对路径。"},
        "sha256": {"$ref": "#/$defs/SHA256"},
        "args": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}},
        "timeoutMs": {"type": "integer", "anyOf": [{"const": 0}, {"minimum": 10, "maximum": 30000}], "description": "每次 DSP 请求的超时，省略或 0 使用 5000 毫秒。"}
      }
    },
    "AudioStart": {
      "type": "object", "additionalProperties": false, "required": ["plan", "ffmpegPath", "ffmpegSHA256", "inputUrl", "outputUrl"],
      "properties": {"plan": {"$ref": "#/$defs/AudioPlan"}, "ffmpegPath": {"type": "string", "minLength": 1}, "ffmpegSHA256": {"$ref": "#/$defs/SHA256"}, "inputUrl": {"$ref": "#/$defs/TaskChannel"}, "outputUrl": {"$ref": "#/$defs/TaskChannel"}, "dspChain": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/DSPNodeSpec"}}, "dspPlugins": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/DSPPlugin"}}},
      "description": "按用户 gain 再接 dspChain 顺序执行；dspPlugins 仅注册可执行节点。PCM 走有界二进制 DSP v1 管道，不进入 JSON-RPC；详见 docs/dsp-plugins.md。"
    },
    "AudioPrepared": {"type": "object", "required": ["profile", "positionOriginMs", "seekMode"], "properties": {"profile": {"const": "mp3-128"}, "positionOriginMs": {"type": "integer", "minimum": 0}, "seekMode": {"const": "timeRestart"}}},
    "AudioComplete": {"type": "object", "required": ["state"], "properties": {"state": {"const": "complete"}}},
    "NCMID": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[!-~]+$", "not": {"pattern": "[/\\\\?#]"}},
    "NCMNonce": {"type": "string", "pattern": "^[a-f0-9]{48}$"},
    "NCMInputChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/[a-f0-9]{48}/input$", "description": "运行时还须校验端口不超过 65535，并与 nonce 完全绑定。"},
    "NCMOutputChannel": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}/[a-f0-9]{48}/output$", "description": "运行时还须校验端口不超过 65535，并与 nonce 完全绑定。"},
    "NCMOpen": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "nonce", "inputUrl", "size"],
      "properties": {
        "taskId": {"allOf": [{"$ref": "#/$defs/NCMID"}, {"maxLength": 196}]}, "assetId": {"$ref": "#/$defs/NCMID"},
        "nonce": {"$ref": "#/$defs/NCMNonce"}, "inputUrl": {"$ref": "#/$defs/NCMInputChannel"}, "size": {"type": "integer", "minimum": 1}
      }
    },
    "NCMMetadata": {
      "type": "object", "additionalProperties": false, "required": ["format", "mime"],
      "properties": {
        "format": {"enum": ["mp3", "flac"]}, "mime": {"enum": ["audio/mpeg", "audio/flac"]},
        "title": {"type": "string", "maxLength": 4096}, "album": {"type": "string", "maxLength": 4096},
        "artists": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "durationMs": {"type": "integer", "minimum": 1}, "bitrateBps": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {"properties": {"format": {"const": "mp3"}, "mime": {"const": "audio/mpeg"}}},
        {"properties": {"format": {"const": "flac"}, "mime": {"const": "audio/flac"}}}
      ]
    },
    "NCMOpened": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "assetId", "nonce", "outputUrl", "size", "metadata"],
      "properties": {
        "taskId": {"allOf": [{"$ref": "#/$defs/NCMID"}, {"maxLength": 196}]}, "assetId": {"$ref": "#/$defs/NCMID"},
        "nonce": {"$ref": "#/$defs/NCMNonce"}, "outputUrl": {"$ref": "#/$defs/NCMOutputChannel"},
        "size": {"type": "integer", "minimum": 1}, "metadata": {"$ref": "#/$defs/NCMMetadata"}
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RequestID"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "oneOf": [
        {"properties":{"method":{"const":"plugin.displayCount"},"params":{"$ref":"#/$defs/DisplayCountRequest"}}},
        {
          "properties": {
            "method": {
              "const": "host.hello"
            },
            "params": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Hello"
                },
                {
                  "$ref": "#/$defs/ScrapeHello"
                }
              ]
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "provider.scan"
            },
            "params": {
              "$ref": "#/$defs/ScanRequest"
            }
          }
        },
        {
          "properties": {
            "method": {
              "enum": [
                "provider.resolve",
                "provider.metadata"
              ]
            },
            "params": {
              "$ref": "#/$defs/ResolveRequest"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "host.entries"
            },
            "params": {
              "$ref": "#/$defs/EntriesRequest"
            }
          }
        },
        {
          "properties": {
            "method": {
              "enum": ["host.state.get", "host.database.get"]
            },
            "params": {
              "$ref": "#/$defs/StateGet"
            }
          }
        },
        {
          "properties": {
            "method": {
              "enum": ["host.state.compareAndSet", "host.database.compareAndSet"]
            },
            "params": {
              "$ref": "#/$defs/StateCAS"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "host.resource"
            },
            "params": {
              "$ref": "#/$defs/ResourceRequest"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "audio.describe"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        },
        {
          "properties": {
            "method": {
              "enum": [
                "audio.prepare",
                "audio.start"
              ]
            },
            "params": {
              "$ref": "#/$defs/AudioStart"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "ncm.open"
            },
            "params": {
              "$ref": "#/$defs/NCMOpen"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "audio.normalize"
            },
            "params": {
              "$ref": "#/$defs/AudioNormalize"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "scrape.search"
            },
            "params": {
              "$ref": "#/$defs/ScrapeSearch"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "scrape.fetch"
            },
            "params": {
              "$ref": "#/$defs/ScrapeFetch"
            }
          }
        }
      ]
    },
    "Success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RequestID"
        },
        "result": {
          "anyOf": [
            {"$ref":"#/$defs/PluginDisplayCount"},
            {
              "$ref": "#/$defs/Ready"
            },
            {
              "$ref": "#/$defs/ScanPage"
            },
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "$ref": "#/$defs/Observation"
            },
            {
              "$ref": "#/$defs/StateResult"
            },
            {
              "$ref": "#/$defs/EntriesPage"
            },
            {
              "$ref": "#/$defs/AudioCapabilities"
            },
            {
              "$ref": "#/$defs/AudioPrepared"
            },
            {
              "$ref": "#/$defs/AudioComplete"
            },
            {
              "$ref": "#/$defs/NCMOpened"
            },
            {
              "$ref": "#/$defs/NormalizedPCMInfo"
            },
            {
              "$ref": "#/$defs/ScrapeSearchResult"
            },
            {
              "$ref": "#/$defs/ScrapeFetchResult"
            }
          ]
        }
      }
    },
    "ErrorData": {
      "type": "object", "required": ["code", "retryable"],
      "properties": {
        "code": {"enum": ["INVALID_ARGUMENT", "AUTH_REQUIRED", "PLATFORM_AUTH_REQUIRED", "ACCESS_DENIED", "NOT_FOUND", "UNSUPPORTED", "SOURCE_OFFLINE", "RESOURCE_CHANGED", "RATE_LIMITED", "TEMPORARY_FAILURE", "CANCELED", "PROTOCOL_MISMATCH", "CONFLICT"]},
        "retryable": {"type": "boolean"}, "retryAfterMs": {"type": "integer", "minimum": 0}
      }
    },
    "Failure": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"}, "id": {"anyOf": [{"$ref": "#/$defs/RequestID"}, {"type": "null"}]},
        "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"enum": [-32700, -32600, -32601, -32602, -32603, -32000]}, "message": {"type": "string", "minLength": 1}, "data": {"$ref": "#/$defs/ErrorData"}}}
      }
    },
    "Cancel": {
      "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"],
      "properties": {"jsonrpc": {"const": "2.0"}, "method": {"const": "$/cancelRequest"}, "params": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/RequestID"}}}}
    }
  }
}
