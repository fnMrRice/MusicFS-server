{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/platform-account.schema.json",
  "title": "平台账号登录 HTTP 契约 v1",
  "$defs": {
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {
        "action": {"enum": ["begin", "poll", "complete", "cancel", "check", "logout"]},
        "loginId": {"type": "string", "maxLength": 128},
        "userToken": {"type": "string", "maxLength": 16384}
      }
    },
    "View": {"type":"object","additionalProperties":false,"required":["state"],"dependentSchemas":{"membershipTier":{"required":["accountId","revision"],"properties":{"state":{"const":"signedIn"}}}},"properties":{"state":{"enum":["signedOut","waiting","scanned","signedIn","unverified","expired","canceled"]},"revision":{"type":"string","minLength":1,"maxLength":128},"accountId":{"type":"string","minLength":1,"maxLength":128},"membershipTier":{"enum":["free","vip","svip"],"description":"最近一次已验证的平台会员档位。平台未明确返回时省略。"},"displayName":{"type":"string","maxLength":512},"avatarUrl":{"type":"string","maxLength":2048,"pattern":"^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,63}/[^?#\\s]*$"},"loginId":{"type":"string","minLength":1,"maxLength":128},"method":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9.-]{0,63}$"},"qrUrl":{"type":"string","maxLength":32768,"pattern":"^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,63}/[^#\\s]*$"},"qrImage":{"type":"string","pattern":"^data:image/png;base64,","maxLength":180000},"expiresAt":{"type":"string","format":"date-time"},"pollAfterSeconds":{"type":"integer","minimum":3}}},
    "Options": {"type":"object","additionalProperties":false,"required":["method","configured","validation"],"properties":{"method":{"type":"string","minLength":1,"maxLength":64},"developerToken":{"type":"string","maxLength":16384},"configured":{"type":"boolean"},"validation":{"type":"string","minLength":1,"maxLength":4096}}}
  }
}
