{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/http.schema.json",
  "title": "MusicFS HTTP v1 模型",
  "$defs": {
    "PluginConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRevision",
        "importOptionsSchema",
        "importDefaults",
        "unavailableOptions"
      ],
      "properties": {
        "schemaRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "importOptionsSchema": {
          "allOf": [
            {
              "$ref": "#/$defs/ImportOptionSchema"
            },
            {
              "required": [
                "type",
                "additionalProperties"
              ],
              "properties": {
                "type": {
                  "const": "object"
                },
                "additionalProperties": {
                  "const": false
                }
              }
            }
          ]
        },
        "importDefaults": {
          "$ref": "#/$defs/ImportOptions"
        },
        "unavailableOptions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "reason"
            ],
            "properties": {
              "code": {
                "const": "UNSUPPORTED"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "ImportOptionSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "object",
            "boolean",
            "integer",
            "string"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ImportOptionSchema"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "default": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "const": {
          "type": [
            "boolean",
            "number",
            "string"
          ]
        },
        "enum": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "if": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "then": {
          "$ref": "#/$defs/ImportOptionSchema"
        },
        "else": {
          "$ref": "#/$defs/ImportOptionSchema"
        }
      },
      "maxProperties": 20,
      "description": "受限本地 JSON Schema；运行时另限制 32 KiB 与 8 层。禁止 $ref、脚本、HTML 执行和未知关键字。"
    },
    "ImportOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "importLyrics": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        },
        "required": [
          "recursive"
        ]
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 1
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "recursive"
          ]
        },
        "then": {
          "properties": {
            "maxDepth": {
              "const": 0
            }
          }
        }
      },
      "description": "部分覆盖；关闭且未给深度规范为 0；从关闭切换开启且未给深度恢复 64。null 与未知字段拒绝。importLyrics=true 在语义校验返回 UNSUPPORTED。"
    },
    "ImportOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recursive",
        "maxDepth",
        "importLyrics"
      ],
      "properties": {
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "importLyrics": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "maxDepth": {
            "const": 0
          }
        }
      }
    },
    "ID": {"type": "string", "minLength": 1, "maxLength": 256},
    "NullableString": {"type": ["string", "null"]},
    "NullableCount": {"type": ["integer", "null"], "minimum": 0},
    "Timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "NullableTimestamp": {"anyOf": [{"$ref": "#/$defs/Timestamp"}, {"type": "null"}]},
    "EvidenceIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "NullableBitrate": {"type": ["integer", "null"], "minimum": 1, "description": "bit/s；未知或不可获得为 null，0 不是有效码率。"},
    "BitrateMode": {"enum": ["cbr", "vbr", "unknown"]},
    "EvidenceOrigin": {"enum": ["provider", "probe", "estimate", "manual"]},
    "SHA512": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
    "NullableSHA512": {"anyOf": [{"$ref": "#/$defs/SHA512"}, {"type": "null"}]},
    "EvidenceRange": {
      "type": "object", "required": ["unit", "start", "end"],
      "description": "半开区间 [start,end)；end 为 null 表示未知。宿主验证 end 不小于 start，字节范围不超出固定资产大小；摘要证据必须覆盖原始完整文件。",
      "properties": {"unit": {"enum": ["bytes", "milliseconds"]}, "start": {"type": "integer", "minimum": 0}, "end": {"$ref": "#/$defs/NullableCount"}}
    },
    "AssetEvidence": {
      "type": "object",
      "required": ["evidenceId", "assetId", "assetVersion", "evidenceVersion", "generation", "kind", "origin", "algorithm", "algorithmVersion", "configRevision", "range", "status", "bitrateBps", "bitrateMode", "sha512", "computedAt", "failureCode", "invalidatedAt"],
      "properties": {
        "evidenceId": {"$ref": "#/$defs/ID"}, "assetId": {"$ref": "#/$defs/ID"}, "assetVersion": {"$ref": "#/$defs/ID"},
        "evidenceVersion": {"const": 1}, "generation": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["bitrate", "providerSha512", "fileSha512"]}, "origin": {"$ref": "#/$defs/EvidenceOrigin"},
        "algorithm": {"$ref": "#/$defs/EvidenceIdentifier"}, "algorithmVersion": {"$ref": "#/$defs/EvidenceIdentifier"}, "configRevision": {"$ref": "#/$defs/EvidenceIdentifier"},
        "range": {"$ref": "#/$defs/EvidenceRange"},
        "status": {"enum": ["pending", "reported", "verified", "unavailable", "failed", "invalidated"]},
        "bitrateBps": {"$ref": "#/$defs/NullableBitrate"}, "bitrateMode": {"$ref": "#/$defs/BitrateMode"}, "sha512": {"$ref": "#/$defs/NullableSHA512"},
        "computedAt": {"$ref": "#/$defs/NullableTimestamp"}, "failureCode": {"anyOf": [{"$ref": "#/$defs/EvidenceIdentifier"}, {"type": "null"}]},
        "invalidatedAt": {"$ref": "#/$defs/NullableTimestamp"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "providerSha512"}}}, "then": {"properties": {"origin": {"const": "provider"}, "algorithm": {"const": "sha512"}}}},
        {"if": {"properties": {"kind": {"const": "fileSha512"}}}, "then": {"properties": {"origin": {"const": "probe"}, "algorithm": {"const": "sha512"}}}},
        {"if": {"properties": {"kind": {"enum": ["providerSha512", "fileSha512"]}}}, "then": {"properties": {"range": {"properties": {"unit": {"const": "bytes"}, "start": {"const": 0}, "end": {"type": "integer"}}}, "bitrateBps": {"type": "null"}, "bitrateMode": {"const": "unknown"}}}},
        {"if": {"properties": {"kind": {"const": "bitrate"}}}, "then": {"properties": {"sha512": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"bitrateBps": {"type": "null"}, "bitrateMode": {"const": "unknown"}, "sha512": {"type": "null"}, "computedAt": {"type": "null"}, "failureCode": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["failed", "unavailable"]}}}, "then": {"properties": {"bitrateBps": {"type": "null"}, "bitrateMode": {"const": "unknown"}, "sha512": {"type": "null"}, "computedAt": {"type": "null"}, "failureCode": {"$ref": "#/$defs/EvidenceIdentifier"}}}},
        {"if": {"properties": {"status": {"const": "reported"}}}, "then": {"properties": {"kind": {"enum": ["bitrate", "providerSha512"]}, "computedAt": {"$ref": "#/$defs/Timestamp"}, "failureCode": {"type": "null"}}, "allOf": [
          {"if": {"properties": {"kind": {"const": "bitrate"}}}, "then": {"properties": {"bitrateBps": {"type": "integer", "minimum": 1}}}},
          {"if": {"properties": {"kind": {"const": "providerSha512"}}}, "then": {"properties": {"sha512": {"$ref": "#/$defs/SHA512"}}}}
        ]}},
        {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"kind": {"const": "fileSha512"}, "sha512": {"$ref": "#/$defs/SHA512"}, "computedAt": {"$ref": "#/$defs/Timestamp"}, "failureCode": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "invalidated"}}}, "then": {"properties": {"invalidatedAt": {"$ref": "#/$defs/Timestamp"}}}, "else": {"properties": {"invalidatedAt": {"type": "null"}}}}
      ]
    },
    "SourceAsset": {
      "type": "object",
      "required": ["assetId", "sourceTrackId", "version", "evidenceVersion", "current", "codec", "container", "durationMs", "fileSizeBytes", "bitrateBps", "bitrateMode", "bitrateOrigin", "providerSha512", "fileSha512", "hashStatus", "hashComputedAt", "hashConflict", "evidence"],
      "properties": {
        "assetId": {"$ref": "#/$defs/ID"}, "sourceTrackId": {"$ref": "#/$defs/ID"}, "version": {"$ref": "#/$defs/ID"}, "evidenceVersion": {"const": 1}, "current": {"type": "boolean"},
        "codec": {"$ref": "#/$defs/NullableString"}, "container": {"$ref": "#/$defs/NullableString"}, "durationMs": {"$ref": "#/$defs/NullableCount"}, "fileSizeBytes": {"$ref": "#/$defs/NullableCount"},
        "bitrateBps": {"$ref": "#/$defs/NullableBitrate"}, "bitrateMode": {"$ref": "#/$defs/BitrateMode"}, "bitrateOrigin": {"anyOf": [{"$ref": "#/$defs/EvidenceOrigin"}, {"type": "null"}]},
        "providerSha512": {"$ref": "#/$defs/NullableSHA512"}, "fileSha512": {"$ref": "#/$defs/NullableSHA512"},
        "hashStatus": {"enum": ["unknown", "pending", "verified", "unavailable", "failed", "invalidated"]}, "hashComputedAt": {"$ref": "#/$defs/NullableTimestamp"},
        "hashConflict": {"anyOf": [{"allOf": [{"$ref": "#/$defs/HashConflict"}, {"properties": {"resolvedAt": {"type": "null"}}}]}, {"type": "null"}]},
        "evidence": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/AssetEvidence"}, {"properties": {"status": {"not": {"const": "invalidated"}}}}]}}
      },
      "allOf": [
        {"if": {"properties": {"hashStatus": {"const": "verified"}}}, "then": {"properties": {"fileSha512": {"$ref": "#/$defs/SHA512"}, "hashComputedAt": {"$ref": "#/$defs/Timestamp"}}}, "else": {"properties": {"fileSha512": {"type": "null"}, "hashComputedAt": {"type": "null"}}}},
        {"if": {"properties": {"hashConflict": {"type": "object"}}}, "then": {"properties": {"current": {"const": true}, "hashStatus": {"const": "verified"}, "providerSha512": {"$ref": "#/$defs/SHA512"}}}},
        {"if": {"properties": {"bitrateBps": {"type": "null"}}}, "then": {"properties": {"bitrateMode": {"const": "unknown"}, "bitrateOrigin": {"type": "null"}}}, "else": {"properties": {"bitrateOrigin": {"$ref": "#/$defs/EvidenceOrigin"}}}},
        {"if": {"properties": {"current": {"const": false}}}, "then": {"properties": {"hashStatus": {"const": "invalidated"}, "evidence": {"maxItems": 0}, "hashConflict": {"type": "null"}}}}
      ]
    },
    "HashConflict": {
      "type": "object", "required": ["conflictId", "providerEvidenceId", "verifiedEvidenceId", "reason", "detectedAt", "resolvedAt"],
      "description": "申报摘要与完整原文件验证摘要不一致；只引用证据，不输出原始路径。当前资产只返回未解决冲突，历史留在内部审计。",
      "properties": {
        "conflictId": {"$ref": "#/$defs/ID"}, "providerEvidenceId": {"$ref": "#/$defs/ID"}, "verifiedEvidenceId": {"$ref": "#/$defs/ID"},
        "reason": {"const": "PROVIDER_SHA512_MISMATCH"}, "detectedAt": {"$ref": "#/$defs/Timestamp"}, "resolvedAt": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },
    "HashRequest": {"type": "object", "additionalProperties": false},
    "HashAccepted": {"type": "object", "required": ["jobId", "merged"], "properties": {"jobId": {"$ref": "#/$defs/ID"}, "merged": {"type": "boolean"}}},
    "HashJob": {
      "type": "object", "required": ["jobId", "sourceTrackId", "assetId", "assetVersion", "status", "progress", "error", "createdAt", "updatedAt"],
      "description": "按所有者读取的持久任务，固定原文件资产及版本；进度是已读取字节数，成功仍须稳定完整读取验证。",
      "properties": {
        "jobId": {"$ref": "#/$defs/ID"}, "sourceTrackId": {"$ref": "#/$defs/ID"}, "assetId": {"$ref": "#/$defs/ID"}, "assetVersion": {"$ref": "#/$defs/ID"},
        "status": {"enum": ["queued", "running", "succeeded", "failed", "unavailable", "cancelled", "superseded"]},
        "progress": {"type": "object", "required": ["completedBytes", "totalBytes"], "properties": {"completedBytes": {"type": "integer", "minimum": 0}, "totalBytes": {"type": "integer", "minimum": 0}}},
        "error": {"anyOf": [{"$ref": "#/$defs/ErrorDetail"}, {"type": "null"}]},
        "createdAt": {"$ref": "#/$defs/Timestamp"}, "updatedAt": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "ErrorDetail": {
      "type": "object", "required": ["code", "message", "requestId", "retryAfter"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "message": {"type": "string", "minLength": 1},
        "requestId": {"$ref": "#/$defs/ID"},
        "retryAfter": {"type": ["number", "null"], "minimum": 0, "description": "建议等待秒数；null 表示没有重试建议。"}
      }
    },
    "Error": {"type": "object", "required": ["error"], "properties": {"error": {"$ref": "#/$defs/ErrorDetail"}}},
    "Health": {
      "type": "object", "required": ["product", "instanceId", "apiVersion", "ready"],
      "properties": {"product": {"const": "MusicFS"}, "instanceId": {"$ref": "#/$defs/ID"}, "apiVersion": {"const": "1"}, "ready": {"type": "boolean"}}
    },
    "Session": {
      "type": "object", "required": ["user", "csrfToken", "expiresAt"],
      "properties": {
        "user": {"type": "object", "required": ["id", "role"], "properties": {"id": {"$ref": "#/$defs/ID"}, "role": {"enum": ["admin"]}}},
        "csrfToken": {"type": "string", "minLength": 16}, "expiresAt": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "Provider": {
      "type": "object",
      "required": [
        "id",
        "name",
        "capabilities",
        "availability",
        "configuration",
        "roots"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "availability": {
          "enum": [
            "available",
            "offline",
            "unavailable"
          ]
        },
        "accountState": {
          "enum": [
            "notRequired",
            "authorized",
            "authRequired"
          ]
        },
        "scanState": {
          "enum": [
            "idle",
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "roots": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/ID"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "Providers": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/Provider"}}}},
    "ScanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "schemaRevision",
        "rootIds",
        "options"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "incremental"
          ]
        },
        "schemaRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "rootIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "options": {
          "$ref": "#/$defs/ImportOverrides"
        }
      }
    },
    "ScanAccepted": {"type": "object", "required": ["jobId", "merged"], "properties": {"jobId": {"$ref": "#/$defs/ID"}, "merged": {"type": "boolean"}}},
    "ScanJob": {
      "type": "object",
      "required": [
        "jobId",
        "providerInstanceId",
        "status",
        "progress",
        "complete",
        "error",
        "lastSuccessAt",
        "rootIds",
        "effectiveOptions",
        "schemaRevision"
      ],
      "properties": {
        "jobId": {
          "$ref": "#/$defs/ID"
        },
        "providerInstanceId": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "progress": {
          "type": "object",
          "required": [
            "observed"
          ],
          "properties": {
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "$ref": "#/$defs/NullableCount"
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastSuccessAt": {
          "$ref": "#/$defs/NullableTimestamp"
        },
        "rootIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "effectiveOptions": {
          "$ref": "#/$defs/ImportOptions"
        },
        "schemaRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "description": "complete 仅表示请求选中的目录与深度范围已完成；其他范围保留。内部计划、真实根身份和配置摘要不公开。"
    },
    "SourceTrack": {
      "type": "object",
      "required": ["sourceTrackId", "providerInstanceId", "displayName", "title", "artists", "durationMs", "codec", "container", "bitrateBps", "availability", "assetId", "asset"],
      "properties": {
        "sourceTrackId": {"$ref": "#/$defs/ID"}, "providerInstanceId": {"$ref": "#/$defs/ID"},
        "displayName": {"type": "string", "minLength": 1}, "title": {"$ref": "#/$defs/NullableString"},
        "artists": {"type": "array", "items": {"type": "string"}},
        "durationMs": {"$ref": "#/$defs/NullableCount"}, "codec": {"$ref": "#/$defs/NullableString"},
        "container": {"$ref": "#/$defs/NullableString"}, "bitrateBps": {"$ref": "#/$defs/NullableBitrate"},
        "availability": {"enum": ["available", "missing", "offline", "unknown"]},
        "assetId": {"$ref": "#/$defs/ID"}, "asset": {"$ref": "#/$defs/SourceAsset"}
      }
    },
    "SourceTracks": {
      "type": "object", "required": ["items", "nextCursor", "libraryRevision"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/SourceTrack"}, "maxItems": 200},
        "nextCursor": {"$ref": "#/$defs/NullableString"}, "libraryRevision": {"$ref": "#/$defs/ID"}
      }
    },
    "Capabilities": {
      "type": "object", "additionalProperties": false, "required": ["htmlAudio", "formats"],
      "properties": {
        "htmlAudio": {"const": true},
        "formats": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["mime", "canPlay"], "properties": {"mime": {"type": "string", "minLength": 1}, "canPlay": {"enum": ["probably", "maybe", ""]}}}}
      }
    },
    "Preferences": {
      "type": "object", "additionalProperties": false,
      "properties": {"forceProcessing": {"type": "boolean", "default": false}, "gainDb": {"type": "number", "minimum": -60, "maximum": 0, "default": 0}}
    },
    "CreatePlayback": {
      "type": "object", "additionalProperties": false, "required": ["sourceTrackId", "capabilities", "preferences"],
      "properties": {"sourceTrackId": {"$ref": "#/$defs/ID"}, "capabilities": {"$ref": "#/$defs/Capabilities"}, "preferences": {"$ref": "#/$defs/Preferences"}}
    },
    "OutputProfile": {
      "type": "object", "required": ["mime", "codec", "container", "transport"],
      "properties": {"mime": {"type": "string", "minLength": 1}, "codec": {"$ref": "#/$defs/NullableString"}, "container": {"$ref": "#/$defs/NullableString"}, "transport": {"const": "htmlAudio"}}
    },
    "Playback": {
      "type": "object",
      "required": ["sessionId", "attemptId", "assetId", "representationId", "deliveryMode", "outputProfile", "streamUrl", "expiresAt", "seekMode", "seekableRange", "positionOriginMs", "effectiveProcessing", "resumeDecision"],
      "properties": {
        "sessionId": {"$ref": "#/$defs/ID"}, "attemptId": {"$ref": "#/$defs/ID"},
        "assetId": {"$ref": "#/$defs/ID"}, "representationId": {"$ref": "#/$defs/ID"},
        "deliveryMode": {"enum": ["proxy", "processed"]}, "outputProfile": {"$ref": "#/$defs/OutputProfile"},
        "streamUrl": {"type": "string", "pattern": "^/api/v1/playback/sessions/[^/?#]+/attempts/[^/?#]+/stream$"},
        "expiresAt": {"$ref": "#/$defs/Timestamp"}, "seekMode": {"enum": ["byteRange", "timeRestart", "none"]},
        "seekableRange": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["startMs", "endMs"], "properties": {"startMs": {"type": "integer", "minimum": 0}, "endMs": {"type": "integer", "minimum": 0}}}]},
        "positionOriginMs": {"type": "integer", "minimum": 0},
        "effectiveProcessing": {"type": "array", "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}, "gainDb": {"type": "number"}, "version": {"type": "string"}, "execution": {"enum": ["server"]}}}},
        "resumeDecision": {"enum": ["continue", "restartRequired", "unavailable"]}
      }
    },
    "Seek": {
      "type": "object", "additionalProperties": false, "required": ["attemptId", "positionMs"],
      "properties": {"attemptId": {"$ref": "#/$defs/ID"}, "positionMs": {"type": "integer", "minimum": 0}}
    },
    "Recover": {
      "type": "object", "additionalProperties": false, "required": ["attemptId", "positionMs", "observedError"],
      "properties": {
        "attemptId": {"$ref": "#/$defs/ID"}, "positionMs": {"type": "integer", "minimum": 0},
        "observedError": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "maxLength": 128}, "message": {"type": "string", "maxLength": 1024}, "outputProfile": {"$ref": "#/$defs/OutputProfile"}}}
      }
    }
  }
}
