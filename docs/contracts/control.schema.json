{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/contracts/control.schema.json",
  "title": "MusicFS WebSocket 控制通道 v1",
  "description": "musicfs.control.v1 的文本 JSON 消息；业务模型沿用 HTTP 契约。音频不在本通道传输。",
  "oneOf": [{"$ref": "#/$defs/ClientMessage"}, {"$ref": "#/$defs/ServerMessage"}],
  "$defs": {
    "ClientMessage": {"oneOf": [{"$ref": "#/$defs/Auth"}, {"$ref": "#/$defs/Ping"}, {"$ref": "#/$defs/Request"}]},
    "ServerMessage": {"oneOf": [{"$ref": "#/$defs/Ready"}, {"$ref": "#/$defs/Pong"}, {"$ref": "#/$defs/Response"}, {"$ref": "#/$defs/Event"}]},
    "RequestID": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
    "Auth": {
      "type": "object", "additionalProperties": false, "required": ["type", "csrfToken"],
      "properties": {"type": {"const": "auth"}, "csrfToken": {"type": "string", "minLength": 16, "maxLength": 128}}
    },
    "Ping": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "ping"}}},
    "Pong": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "pong"}}},
    "Ready": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "instanceId", "heartbeatIntervalMs", "heartbeatTimeoutMs"],
      "properties": {
        "type": {"const": "ready"}, "instanceId": {"$ref": "#/$defs/RequestID"},
        "heartbeatIntervalMs": {"const": 10000}, "heartbeatTimeoutMs": {"const": 30000}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "method", "path"],
      "properties": {
        "type": {"const": "request"}, "id": {"$ref": "#/$defs/RequestID"},
        "method": {"enum": ["GET", "POST", "DELETE"]},
        "path": {"type": "string", "maxLength": 512, "pattern": "^/[A-Za-z0-9_/-]+$"},
        "idempotencyKey": {"type": "string", "maxLength": 128}, "body": {"type": "object"}
      },
      "oneOf": [
        {"properties": {"method": {"const": "GET"}, "path": {"const": "/lifecycle"}}},
        {"required": ["body", "idempotencyKey"], "properties": {"method": {"const": "POST"}, "path": {"const": "/lifecycle/leases"}, "body": {"$ref": "./http.schema.json#/$defs/LifecycleAcquireRequest"}}},
        {"required": ["body"], "properties": {"method": {"const": "POST"}, "path": {"pattern": "^/lifecycle/leases/[A-Za-z0-9_-]{1,128}/renew$"}, "body": {"$ref": "./http.schema.json#/$defs/LifecycleRenewRequest"}}},
        {"required": ["body"], "properties": {"method": {"const": "POST"}, "path": {"pattern": "^/lifecycle/leases/[A-Za-z0-9_-]{1,128}/release$"}, "body": {"$ref": "./http.schema.json#/$defs/LifecycleReleaseRequest"}}},
        {"required": ["body", "idempotencyKey"], "properties": {"method": {"const": "POST"}, "path": {"const": "/playback/sessions"}, "body": {"$ref": "./http.schema.json#/$defs/CreatePlayback"}}},
        {"properties": {"method": {"const": "DELETE"}, "path": {"pattern": "^/playback/sessions/[A-Za-z0-9_-]{1,128}$"}}},
        {"required": ["body", "idempotencyKey"], "properties": {"method": {"const": "POST"}, "path": {"pattern": "^/playback/sessions/[A-Za-z0-9_-]{1,128}/seek$"}, "body": {"$ref": "./http.schema.json#/$defs/Seek"}}},
        {"required": ["body", "idempotencyKey"], "properties": {"method": {"const": "POST"}, "path": {"pattern": "^/playback/sessions/[A-Za-z0-9_-]{1,128}/recover$"}, "body": {"$ref": "./http.schema.json#/$defs/Recover"}}},
        {"required": ["body", "idempotencyKey"], "properties": {"method": {"const": "POST"}, "path": {"pattern": "^/playback/sessions/[A-Za-z0-9_-]{1,128}/recover-source$"}, "body": {"$ref": "./http.schema.json#/$defs/RecoverSource"}}}
      ]
    },
    "Response": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "status"],
      "properties": {
        "type": {"const": "response"}, "id": {"$ref": "#/$defs/RequestID"},
        "status": {"type": "integer", "minimum": 200, "maximum": 599}, "body": {}
      },
      "if": {"properties": {"status": {"minimum": 400}}},
      "then": {"required": ["body"], "properties": {"body": {"$ref": "./http.schema.json#/$defs/Error"}}}
    },
    "Event": {
      "type": "object", "additionalProperties": false, "required": ["type", "event", "data"],
      "properties": {"type": {"const": "event"}, "event": {"type": "string"}, "data": {}},
      "oneOf": [
        {"properties": {"event": {"const": "capabilities.changed"}, "data": {"$ref": "./http.schema.json#/$defs/CapabilitiesChangedEvent"}}},
        {"properties": {"event": {"const": "activity.changed"}, "data": {
          "type": "object", "additionalProperties": false, "required": ["resources"],
          "properties": {"resources": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["scans", "tasks", "pluginJobs", "playlistSync"]}}}
        }}},
        {"properties": {"event": {"const": "lifecycle.changed"}, "data": {"$ref": "./http.schema.json#/$defs/LifecycleStatus"}}}
      ]
    }
  }
}
