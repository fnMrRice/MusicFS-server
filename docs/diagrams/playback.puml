@startuml
title MusicFS - Playback and Fallback
actor User
participant Client
participant "Server / Resolver" as Server
participant Provider
participant "Stream Gateway" as Stream
User -> Client : Play recording
Client -> Server : Create session + capabilities
Server -> Provider : resolveStream(account, source)
Provider --> Server : Resource + expiry + restrictions
alt Safe direct playback
 Server --> Client : Scoped playback descriptor
 Client -> Provider : Pull accessible stream
else Proxy required
 Server --> Client : Session stream URL
 Client -> Stream : GET + Range + session token
 Stream -> Provider : Pull authorized bytes
 Provider --> Stream : Bytes / range metadata
 Stream --> Client : 200 / 206 audio
end
alt URL expired
 Client -> Server : Refresh session
 Server -> Provider : Resolve same source again
 Server --> Client : Refreshed descriptor
else Source playback failed
 Client -> Server : Fallback + failure + position
 Server -> Server : Exclude attempted sources; enforce limit
 Server -> Provider : Resolve eligible alternative
 Server --> Client : Alternative or classified failure
 Client -> Client : Resume only when version and seek allow
end
@enduml
