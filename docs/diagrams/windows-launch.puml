@startuml
title MusicFS - Windows Server Connection
start
:Read configured connection mode;
if (Managed local?) then (yes)
 :Check health and authenticated identity;
 if (Ready and compatible?) then (yes)
  :Connect;
 else (no)
  :Acquire per-user startup lock;
  :Recheck health / process / port;
  if (Known server starting?) then (yes)
   :Wait with bounded backoff;
  else (no)
   if (Port occupied or identity mismatch?) then (yes)
    :Show conflict and configuration;
    stop
   else (no)
    :Launch packaged sidecar with allowlisted args;
    :Wait with bounded backoff;
   endif
  endif
  if (Ready within deadline?) then (yes)
   :Authenticate and connect;
  else (no)
   :Show logs and retry action;
   stop
  endif
 endif
else (no)
 :Connect to configured remote or external local server;
 if (Connection successful?) then (yes)
  :Authenticate and connect;
 else (no)
  :Show connection or service status;
  stop
 endif
endif
:Open client;
stop
@enduml
