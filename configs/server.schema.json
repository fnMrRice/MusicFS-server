{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicfs.invalid/configs/server.schema.json",
  "title": "MusicFS Server YAML 配置版本 1",
  "description": "用于 YAML 的编辑器和结构验证。加载器额外限制单文档、1 MiB、32 层、严格标量、无 null/重复键/自定义标签/anchor/alias/merge，并校验唯一身份、Origin、路径隔离与环境凭据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion", "allowedOrigins"],
  "properties": {
    "pluginBundle": {"$ref": "#/$defs/Path"},
    "configVersion": {"const": 1},
    "listen": {"type": "string", "minLength": 1, "default": "127.0.0.1:8080"},
    "allowLoopbackHttp": {"type": "boolean", "default": false},
    "allowedOrigins": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dataRoot": {"$ref": "#/$defs/NonemptyPath", "default": "data"},
    "mediaRoot": {"$ref": "#/$defs/NonemptyPath", "default": "media"},
    "cacheRoot": {"$ref": "#/$defs/NonemptyPath", "default": "cache"},
    "webRoot": {"$ref": "#/$defs/Path"},
    "tlsCert": {"$ref": "#/$defs/Path"},
    "tlsKey": {"$ref": "#/$defs/Path"},
    "maxSessions": {"type": "integer", "minimum": 1, "maximum": 128, "default": 8},
    "maxProcessing": {"type": "integer", "minimum": 1, "maximum": 8, "default": 2},
    "maxCacheBytes": {"type": "integer", "minimum": 1048576, "maximum": 9223372036854775807, "default": 1073741824},
    "sessionTtlSeconds": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 3600},
    "writeBack": {
      "type": "object", "additionalProperties": false,
      "description": "默认禁用的显式本地FLAC写回；不自动授权所有音乐根，不接受路径或原始正文。启用时加载器还校验每个Local Files实例与根的双层启用状态。",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "allowOverwrite": {"type": "boolean", "default": false},
        "maxFileBytes": {"type": "integer", "minimum": 46, "maximum": 1099511627776, "default": 8589934592},
        "roots": {"type": "array", "maxItems": 256, "uniqueItems": true, "default": [], "items": {
          "type": "object", "additionalProperties": false, "required": ["instanceId", "rootId", "fields"],
          "properties": {
            "instanceId": {"$ref": "#/$defs/ID"}, "rootId": {"$ref": "#/$defs/ID"},
            "fields": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["lyrics", "artwork"]}}
          }
        }}
      },
      "if": {"required": ["enabled"], "properties": {"enabled": {"const": true}}},
      "then": {"required": ["roots"], "properties": {"roots": {"minItems": 1}}}
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "automatic": {
          "type": "object", "additionalProperties": false,
          "description": "成功扫描后的独立自动补缺策略，默认关闭。单次导入歌词另由 importLyrics 控制。实例优先级按声明顺序，人工锁不可覆盖。",
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "instancePriority": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}},
            "fields": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["lyrics", "artwork"]}, "default": ["lyrics", "artwork"]},
            "languages": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"}}
          },
          "if": {"required": ["enabled"], "properties": {"enabled": {"const": true}}},
          "then": {"properties": {"fields": {"minItems": 1}}}
        }
      }
    },
    "fingerprinting": {
      "type": "object",
      "additionalProperties": false,
      "description": "手动本实例音频指纹；固定 Chromaprint 1.6.1/算法 2，禁用时不启动工具，无自动上传或外部检索。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "fpcalcPath": {
          "$ref": "#/$defs/Path",
          "default": ""
        },
        "fpcalcSha256": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{64})?$",
          "default": ""
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        }
      },
      "if": {
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "fpcalcPath",
          "fpcalcSha256"
        ],
        "properties": {
          "fpcalcPath": {
            "$ref": "#/$defs/NonemptyPath"
          },
          "fpcalcSha256": {
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "hashing": {
      "type": "object", "additionalProperties": false,
      "description": "完整原文件 SHA-512 后台任务；auto=false 仅关闭自动排队，手动任务仍可用。速率是所有哈希任务共享的总预算。",
      "properties": {
        "auto": {"type": "boolean", "default": false},
        "maxConcurrent": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
        "bytesPerSecond": {"type": "integer", "minimum": 65536, "maximum": 1073741824, "default": 4194304}
      }
    },
    "plugins": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/LocalPlugin"}, {"$ref": "#/$defs/FFmpegPlugin"}, {"$ref": "#/$defs/NCMPlugin"}, {"$ref": "#/$defs/LocalScraperPlugin"}, {"$ref": "#/$defs/OnlinePlugin"}]}}
  },
  "allOf": [
    {
      "if": {
        "required": [
          "fingerprinting"
        ],
        "properties": {
          "fingerprinting": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "plugins"
        ],
        "properties": {
          "plugins": {
            "contains": {
              "required": [
                "pluginId",
                "enabled",
                "instances"
              ],
              "properties": {
                "pluginId": {
                  "const": "musicfs.audio.ffmpeg"
                },
                "instances": {
                  "contains": {
                    "required": [
                      "role",
                      "enabled"
                    ],
                    "properties": {
                      "role": {
                        "const": "audio"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "OnlinePlugin": {"allOf": [{"$ref": "#/$defs/Plugin"}], "description": "匿名固定平台适配；加载器额外限制三平台总共最多16实例。禁止配置URL、Cookie、token或导入选项。", "properties": {"pluginId": {"enum": ["musicfs.netease", "musicfs.qqmusic", "musicfs.applemusic"]}, "instances": {"type": "array", "maxItems": 16, "items": {"allOf": [{"$ref": "#/$defs/Instance"}], "properties": {"role": {"const": "provider"}, "config": {"type": "object", "additionalProperties": false}, "importDefaults": false}}}}},
    "ImportOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recursive": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "开启递归时 0 表示不限深度，1—64 表示最多进入的子目录层数；关闭递归时只能为 0。"
        },
        "importLyrics": {
          "type": "boolean"
        },
        "skipHidden": {"type": "boolean", "description": "跳过点开头条目和 Windows 隐藏文件、目录。"},
        "respectNoMedia": {"type": "boolean", "description": "遵循 .nomedia 标记，跳过所在目录及子目录。"},
        "excludePatterns": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "根相对 / 路径，*、? 和独立段 **；大小写敏感。匹配目录排除整支。运行时另验证UTF-8字节上限、禁止绝对/点路径、反斜线、字符类和否定。"
        }
      },
      "if": {
        "properties": {
          "recursive": {
            "const": true
          }
        },
        "required": [
          "recursive"
        ]
      },
      "then": {
        "properties": {
          "maxDepth": {
            "minimum": 0
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "recursive"
          ]
        },
        "then": {
          "properties": {
            "maxDepth": {
              "const": 0
            }
          }
        }
      },
      "description": "部分覆盖；关闭且未给深度规范为 0；从关闭切换开启且未给深度恢复 0；开启递归时 0 表示不限深度，1—64 表示子目录层数。null 与未知字段拒绝。importLyrics 在成功扫描后按资产版本补齐缺失且未人工锁定的歌词；需启用本地 Scraper。"
    },
    "ID": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "Path": {"type": "string", "not": {"pattern": "\u0000"}},
    "NonemptyPath": {"$ref": "#/$defs/Path", "minLength": 1},
    "Enabled": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"const": true}}},
    "BundledPlugin": {"required": ["args"], "properties": {"args": {"type": "array", "prefixItems": [{"const": "--plugin"}], "minItems": 2}}},
    "Plugin": {
      "type": "object", "additionalProperties": false, "required": ["pluginId"],
      "properties": {
        "pluginId": {"enum": ["musicfs.localfiles", "musicfs.audio.ffmpeg", "musicfs.ncm", "musicfs.scraper.local", "musicfs.netease", "musicfs.qqmusic", "musicfs.applemusic"]},
        "executable": {"$ref": "#/$defs/Path"},
        "args": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 4096, "pattern": "^[^\u0000]*$"}},
        "sha256": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{64})?$"},
        "enabled": {"type": "boolean", "default": false},
        "instances": {"type": "array"}
      },
      "if": {"allOf": [{"$ref": "#/$defs/Enabled"}, {"properties": {"instances": {"contains": {"$ref": "#/$defs/Enabled"}}}}]},
      "then": {"required": ["executable"], "properties": {"executable": {"$ref": "#/$defs/NonemptyPath"}}}
    },
    "Instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "role",
        "config"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/ID"
        },
        "permissions": {"type": "object", "additionalProperties": false, "required": ["readDirectories"], "properties": {"readDirectories": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/NonemptyPath"}}}},
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "provider",
            "audio",
            "scraper"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "config": {
          "type": "object"
        },
        "importDefaults": {
          "$ref": "#/$defs/ImportOverrides"
        }
      }
    },
    "MusicRoot": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "path"],
      "properties": {"id": {"$ref": "#/$defs/ID"}, "name": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/NonemptyPath"}}
    },
    "LocalSettings": {
      "type": "object", "additionalProperties": false,
      "properties": {"musicRoots": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/MusicRoot"}}, "watch": {"$ref": "#/$defs/Watch"}}
    },
    "Watch": {
      "type": "object", "additionalProperties": false,
      "description": "宿主通知提示与周期复核，默认关闭。每实例最多256目录、合并一个待处理提示；最多8个双层启用的监听实例。maxDelayMs须不小于debounceMs，通知失败退化周期复核，paused任务停止自动提交直至重启。",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "debounceMs": {"type": "integer", "minimum": 100, "maximum": 30000, "default": 1000},
        "maxDelayMs": {"type": "integer", "minimum": 100, "maximum": 60000, "default": 10000},
        "fullRescanSeconds": {"type": "integer", "minimum": 30, "maximum": 86400, "default": 3600}
      }
    },
    "FFmpegSettings": {
      "type": "object", "additionalProperties": false,
      "properties": {"ffmpegPath": {"$ref": "#/$defs/Path"}, "ffprobePath": {"$ref": "#/$defs/Path"}}
    },
    "LocalPlugin": {
      "allOf": [{"$ref": "#/$defs/Plugin"}],
      "properties": {
        "pluginId": {"const": "musicfs.localfiles"},
        "instances": {"items": {"allOf": [{"$ref": "#/$defs/Instance"}], "properties": {"role": {"const": "provider"}, "config": {"$ref": "#/$defs/LocalSettings"}}}}
      },
      "description": "permissions 限定可浏览和选择的目录范围；未选择 musicRoots 时处于待配置状态，可通过管理员目录接口选择授权根或子目录。"
    },
    "FFmpegPlugin": {
      "allOf": [
        {
          "$ref": "#/$defs/Plugin"
        }
      ],
      "properties": {
        "pluginId": {
          "const": "musicfs.audio.ffmpeg"
        },
        "instances": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Instance"
              }
            ],
            "properties": {
              "role": {
                "const": "audio"
              },
              "config": {
                "$ref": "#/$defs/FFmpegSettings"
              },
              "importDefaults": false
            }
          }
        }
      },
      "if": {"allOf": [{"$ref": "#/$defs/Enabled"}, {"not": {"$ref": "#/$defs/BundledPlugin"}}]},
      "then": {
        "properties": {
          "instances": {
            "contains": {
              "$ref": "#/$defs/Enabled"
            },
            "minContains": 0,
            "maxContains": 1,
            "items": {
              "if": {
                "$ref": "#/$defs/Enabled"
              },
              "then": {
                "properties": {
                  "config": {
                    "required": [
                      "ffmpegPath",
                      "ffprobePath"
                    ],
                    "properties": {
                      "ffmpegPath": {
                        "$ref": "#/$defs/NonemptyPath"
                      },
                      "ffprobePath": {
                        "$ref": "#/$defs/NonemptyPath"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "LocalScraperPlugin": {"allOf": [{"$ref": "#/$defs/Plugin"}], "properties": {"pluginId": {"const": "musicfs.scraper.local"}, "instances": {"items": {"allOf": [{"$ref": "#/$defs/Instance"}], "properties": {"role": {"const": "scraper"}, "config": {"type": "object", "additionalProperties": false}, "importDefaults": false}}, "maxItems": 16}}},
    "NCMPlugin": {
      "allOf": [
        {
          "$ref": "#/$defs/Plugin"
        }
      ],
      "properties": {
        "pluginId": {
          "const": "musicfs.ncm"
        },
        "instances": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Instance"
              }
            ],
            "properties": {
              "role": {
                "const": "audio"
              },
              "config": {
                "type": "object",
                "maxProperties": 0
              },
              "importDefaults": false
            }
          }
        }
      },
      "if": {
        "$ref": "#/$defs/Enabled"
      },
      "then": {
        "properties": {
          "instances": {
            "contains": {
              "$ref": "#/$defs/Enabled"
            },
            "minContains": 0,
            "maxContains": 1
          }
        }
      }
    }
  }
}
